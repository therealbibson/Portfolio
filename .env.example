# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Brevo Configuration (contact form)
# The contact form is delivered by the /api/send-message serverless
# function, which calls the Brevo Transactional API. These are
# SERVER-SIDE variables only — never prefix them with VITE_, and never
# put the API key in client-side code.
# Set BREVO_API_KEY in the Vercel dashboard (Settings -> Environment
# Variables) and, for local `vercel dev` testing, in your local .env.
# Obtain the key from your Brevo dashboard (Settings -> SMTP & API -> API Keys).
BREVO_API_KEY="your_brevo_api_key"

# BREVO_SENDER_EMAIL: the address Brevo sends from. It must be a verified
# sender in Brevo (Settings -> Senders & IP -> Senders). Defaults to
# uabeeb3@gmail.com if not set.
BREVO_SENDER_EMAIL="uabeeb3@gmail.com"
